# SPECTRA backend environment (copy to .env and fill in as needed).
# NEVER commit .env — it is gitignored. Values below are examples, not defaults.

# --- Database ---------------------------------------------------------------
# SQLite path inside the container (compose default: /app/data/spectra.db).
SPECTRA_DATABASE_URL=sqlite:////app/data/spectra.db

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list. Browser use through nginx is same-origin, so
# the default covers local dev origins. Add your deployment origin if any
# cross-origin client will call the API directly.
SPECTRA_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Authentication (M1) ----------------------------------------------------
# 0/unset = auth disabled (guest mode; all visitors share conversations).
# 1 = auth required. When enabling, you MUST also set SPECTRA_AUTH_SECRET.
SPECTRA_AUTH_ENABLED=0
# Server-side signing key for bearer tokens. Generate with:
#   openssl rand -hex 32
SPECTRA_AUTH_SECRET=
# Bearer token lifetime in seconds (default 86400 = 24h).
SPECTRA_AUTH_TOKEN_TTL_SECONDS=86400

# --- AI provider (M4) -------------------------------------------------------
# Both must be set for AI features to activate. Without them the AI endpoints
# return 503 with a safe message; /api/release reports ai_provider_state.
# Get a key from Google AI Studio. Never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Rate limiting (opt-in cost control) ------------------------------------
# 0/unset = disabled. 1 = enable the per-IP fixed-window limiter.
SPECTRA_RATE_LIMIT_ENABLED=0
SPECTRA_RATE_LIMIT_PUBLIC=240
SPECTRA_RATE_LIMIT_AI=30
# Comma-separated IPs allowed to set X-Forwarded-For (leave empty when the
# API is reached directly rather than through a proxy).
SPECTRA_TRUSTED_PROXIES=

# --- Release identity (M2.1) ------------------------------------------------
# Injected at build/deploy time by the release pipeline; exposed read-only
# at /api/release for stale-client diagnostics. Not secrets.
SPECTRA_RELEASE_VERSION=
SPECTRA_RELEASE_SHA=
SPECTRA_RELEASE_BUILT_AT=
SPECTRA_IMAGE_DIGEST=
