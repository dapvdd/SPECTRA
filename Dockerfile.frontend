FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

RUN printf 'server {\n\
    listen 8080;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # S-1 security headers (defined at server level; locations that set any\n\
    # add_header of their own re-declare them, because nginx inherits\n\
    # add_header only when a block defines none of its own).\n\
    add_header X-Content-Type-Options nosniff always;\n\
    add_header X-Frame-Options DENY always;\n\
    add_header Referrer-Policy no-referrer always;\n\
    # CSP derived from the served artifact: one inline theme-boot script\n\
    # (hash-pinned), Vite hashed assets, Google Fonts (style + font fetch).\n\
    # script-src has no unsafe-inline/eval; style-src keeps unsafe-inline so\n\
    # dynamic theme styling can never break under future asset changes.\n\
    add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'sha256-w9eABZuoe9jkbDmw0yxZTUjdDLgEWhWOqkKI0M+zbNM='"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"' https://fonts.googleapis.com; font-src '"'"'self'"'"' https://fonts.gstatic.com; img-src '"'"'self'"'"'; connect-src '"'"'self'"'"'; object-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'" always;\n\
\n\
    location /api/ {\n\
        # Backend sets its own strict security headers (CSP default-src 'none').\n\
        # Hide them here and re-declare explicitly so responses carry ONE clean\n\
        # header set instead of duplicates (nginx server-level + backend).\n\
        proxy_hide_header X-Content-Type-Options;\n\
        proxy_hide_header X-Frame-Options;\n\
        proxy_hide_header Referrer-Policy;\n\
        proxy_hide_header Content-Security-Policy;\n\
        add_header X-Content-Type-Options nosniff always;\n\
        add_header X-Frame-Options DENY always;\n\
        add_header Referrer-Policy no-referrer always;\n\
        add_header Content-Security-Policy "default-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'" always;\n\
        # M3.4 Task 6: keep large proxied JSON in memory instead of spilling\n\
        # to a disk temp file (removes the 'upstream response is buffered to\n\
        # a temporary file' warn + disk I/O on every unfiltered catalog load).\n\
        proxy_max_temp_file_size 0;\n\
        proxy_buffers 16 16k;\n\
        proxy_buffer_size 16k;\n\
        # Compress proxied JSON when the backend did not (defense in depth).\n\
        gzip on;\n\
        gzip_types application/json;\n\
        gzip_min_length 1024;\n\
        gzip_proxied any;\n\
        gzip_vary on;\n\
        proxy_pass http://backend:8000/;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
    # Vite emits content-hashed filenames, so hashed assets are immutable.\n\
    # Long cache here is safe: a new build changes the URL, not the content.\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        add_header X-Content-Type-Options nosniff always;\n\
        add_header X-Frame-Options DENY always;\n\
        add_header Referrer-Policy no-referrer always;\n\
        add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'sha256-w9eABZuoe9jkbDmw0yxZTUjdDLgEWhWOqkKI0M+zbNM='"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"' https://fonts.googleapis.com; font-src '"'"'self'"'"' https://fonts.gstatic.com; img-src '"'"'self'"'"'; connect-src '"'"'self'"'"'; object-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'" always;\n\
    }\n\
    # The HTML shell references the hashed assets by name, so it must always\n\
    # be revalidated: no-cache keeps the ETag revalidation but never serves\n\
    # a stale shell pointing at assets that no longer exist.\n\
    location = /index.html {\n\
        add_header Cache-Control "no-cache";\n\
        add_header X-Content-Type-Options nosniff always;\n\
        add_header X-Frame-Options DENY always;\n\
        add_header Referrer-Policy no-referrer always;\n\
        add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'sha256-w9eABZuoe9jkbDmw0yxZTUjdDLgEWhWOqkKI0M+zbNM='"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"' https://fonts.googleapis.com; font-src '"'"'self'"'"' https://fonts.gstatic.com; img-src '"'"'self'"'"'; connect-src '"'"'self'"'"'; object-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'" always;\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
