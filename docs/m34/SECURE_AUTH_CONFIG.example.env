# SPECTRA Secure Authentication Configuration (M3.4 Task 2 — PREPARED, NOT ACTIVATED)
#
# Status: TEMPLATE ONLY. Applying this to DavidLab production requires
# explicit owner approval (mission constraint: "Do not change live
# authentication settings without owner approval").
#
# Purpose: fail-closed posture for a multi-user tailnet. Audit finding
# (M34_SECURITY_REPORT.md §3): the tailnet spans three user namespaces
# (dapvdd@, mukhlisinfatah406@, devinevos09@). With auth disabled,
# tailnet membership equals full API access — membership is NOT
# authorization. This config enables identity + scoped conversations.

# --- Enable authentication --------------------------------------------------
SPECTRA_AUTH_ENABLED=1

# Server-side signing key. REQUIRED when auth is enabled. Generate ON THE
# HOST (never transmit through chat/tickets), e.g.:
#   openssl rand -hex 32
# Store in /home/david/secrets/spectra_auth_secret (chmod 600, owner david)
# and load at deploy time; never commit the value anywhere.
SPECTRA_AUTH_SECRET=<generate-on-host>

# Bearer token lifetime (seconds). 8h limits a leaked token's window.
SPECTRA_AUTH_TOKEN_TTL_SECONDS=28800

# Registration: with a single-operator deployment, close self-registration
# and create the operator account out-of-band:
#   docker exec spectra-backend python -m backend.app.scripts.bootstrap_admin \
#     --username <operator>
# (bootstrap_admin prompts for the password; it is never echoed.)
SPECTRA_AUTH_REGISTRATION_ENABLED=0

# --- CORS (same-origin through nginx; keep the allowlist minimal) -----------
SPECTRA_CORS_ORIGINS=http://100.113.157.0:8080

# --- Rate limiting (defense-in-depth now that AI + auth are on) -------------
SPECTRA_RATE_LIMIT_ENABLED=1
SPECTRA_RATE_LIMIT_PUBLIC=240
SPECTRA_RATE_LIMIT_AI=30
SPECTRA_TRUSTED_PROXIES=172.19.0.0/16

# --- Activation procedure (requires owner approval; NOT executed) ----------
# 1. Owner approves this file and picks a maintenance window.
# 2. On david-lab: generate secret into /home/david/secrets/spectra_auth_secret.
# 3. Add the variables to the release compose environment (compose-m34.json).
# 4. deploy_release.sh --release-dir /home/david/releases/spectra-<sha>-ops \
#      --expected-sha <approved-sha>   (preflight validates everything).
# 5. Post-cutover acceptance:
#      curl -s http://100.113.157.0:8080/api/auth/status   -> {"auth_enabled":true}
#      unauthenticated /api/build/conversations            -> 401
#      login with the operator account                      -> 200
# 6. Rollback: redeploy previous compose without the auth env (documented in
#    M34_OPERATIONS_RUNBOOK.md).
